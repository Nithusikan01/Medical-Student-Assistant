# Copy to /opt/msa/.env on the server, fill in, then `chmod 600 .env`.
# Never commit the real file.
#
# Generate the random values with `openssl rand -hex 32`. Hex keeps them free
# of `$`, quotes and `#`, which docker compose would otherwise try to
# interpolate or treat as a comment.

# --- Used by docker-compose.yml itself ---
POSTGRES_PASSWORD=
# Must match the X-Origin-Verify custom header on the CloudFront origin.
ORIGIN_SECRET=

# --- The backend's environment (same keys the Secrets Manager secret held) ---
# Repeat POSTGRES_PASSWORD's value literally here; the host is the compose
# service name, not localhost.
DATABASE_URL=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@postgres:5432/medical_assistant

PINECONE_API_KEY=
PINECONE_INDEX_NAME=
GEMINI_API_KEY=
# Leave empty to offer Gemini models only.
GROQ_API_KEY=

# JWT signing key, at least 32 characters.
SECRET_KEY=
ADMIN_EMAIL=
# 12+ characters, or the admin is not seeded.
ADMIN_PASSWORD=

COOKIE_SECURE=true
ALLOW_OPEN_REGISTRATION=true
CORS_ORIGINS=https://d1u7p8d1507l08.cloudfront.net
