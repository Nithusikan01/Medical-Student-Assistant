# ---------------------------------------------------------------------------
# Backend environment configuration
#
# Copy this file to .env in this same directory, then fill in your credentials:
#
#   Copy-Item .env.example .env
#
# .env is gitignored - never commit real keys.
# Retrieval variables are read in rag/src/rag/config/settings.py;
# auth and database variables in backend/src/backend/auth/config.py.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------

# Pinecone API key.
PINECONE_API_KEY=

# Pinecone index to create or reuse. It is created automatically on first run
# with cosine similarity on AWS us-east-1, sized to the embedding model.
PINECONE_INDEX_NAME=

# Google Gemini API key.
GEMINI_API_KEY=

# PostgreSQL connection string, e.g.
#   postgresql+psycopg://user:password@localhost:5432/medical_assistant
DATABASE_URL=

# Signing key for access tokens. At least 32 characters, and treat it like a
# password: changing it invalidates every issued access token. Generate one
# with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Required: first admin -------------------------------------------------

# Seeded on startup if no user with this address exists. An existing user's
# password is never overwritten, so rotating this does not reset the account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional: authentication ----------------------------------------------

# When false, registration requires a valid invite code.
# ALLOW_OPEN_REGISTRATION=false

# OAuth client id from Google Cloud Console. Sign-in with Google is disabled
# while this is empty. Must match VITE_GOOGLE_CLIENT_ID in the frontend.
# GOOGLE_CLIENT_ID=

# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30

# Set to true wherever the app is served over HTTPS, so the refresh cookie
# only travels encrypted. Leave false for local http:// development, or the
# browser will silently drop the cookie.
# COOKIE_SECURE=false

# Comma-separated origins allowed to call the API with credentials, e.g.
# the deployed frontend's URL. Falls back to localhost:5173 for local dev.
# CORS_ORIGINS=https://your-cloudfront-domain.cloudfront.net

# --- Optional: storage -----------------------------------------------------

# Holds uploads/ before ingestion deletes them. Relative paths resolve
# against the working directory, so run the API and scripts from backend/.
# STORAGE_PATH=storage

# --- Optional: chunking ----------------------------------------------------

# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# --- Optional: embedding and reranking -------------------------------------

# Hosted inference (the default) runs embedding and reranking through
# Pinecone's API, so no model weights are downloaded and the service starts in
# seconds. Set this to false to run local models instead, which needs the rag
# package's extra:  pip install -e "./rag[local-models]"
# USE_HOSTED_INFERENCE=true

# Hosted models. The embedding dimension is fixed by the model, and a Pinecone
# index cannot be resized, so changing the model means creating a new index and
# re-ingesting. llama-text-embed-v2 and multilingual-e5-large are both 1024.
# HOSTED_EMBEDDING_MODEL=llama-text-embed-v2
# HOSTED_EMBEDDING_DIMENSION=1024
# HOSTED_RERANK_MODEL=bge-reranker-v2-m3

# Used only when USE_HOSTED_INFERENCE=false.
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_BATCH_SIZE=32

# --- Optional: retrieval ---------------------------------------------------

# These populate RetrievalConfig, but note what the live query path actually
# uses today: top_k comes from the request body, and candidate_k defaults to 30
# in HistoryAwareRAGService.answer_with_sources. CANDIDATE_K applies only to
# DenseRetriever calls that pass no explicit top_k.
# CANDIDATE_K=20
# DENSE_TOP_K=20
# RERANKING_K=8
# FINAL_CONTEXT_K=5
# SIMILARITY_THRESHOLD=0.7

# --- Optional: generation --------------------------------------------------

# GENERATION_MODEL_NAME=gemini-3.1-flash-lite

# Groq API key, from https://console.groq.com/home. Enables the Groq-backed
# generation models (GPT-OSS 120B/20B, Qwen3.8-27B) as user-selectable
# alternatives to Gemini in GET /api/models. Left empty, those options are
# simply not offered.
# GROQ_API_KEY=

# --- Optional: ingestion ---------------------------------------------------

# How long a document may sit in "processing" with no sign of life before
# it is marked failed. Ingestion touches a heartbeat as each batch of
# chunks lands, so this only fires on an ingest that genuinely stopped -
# most often because the server was restarted mid-upload, which raises no
# exception and so leaves the row stuck otherwise.
#
# Raise it if you ingest very large documents on slow hardware; the only
# cost of waiting is a row that reads "processing" for longer.
# INGEST_STALL_MINUTES=15

# --- Optional: monitoring --------------------------------------------------

# Telemetry is on by default. Off means no tracer, no background writer, and
# no rows in rag_traces / rag_spans - the API behaves exactly as it did
# before monitoring existed.
# TELEMETRY_ENABLED=true

# Fraction of requests traced, 0.0 to 1.0. Full tracing is appropriate at
# this application's traffic; lower it if the telemetry tables grow faster
# than you want to retain them.
# TELEMETRY_SAMPLE_RATE=1.0

# The writer is a single background thread fed by a bounded queue. On a
# burst it drops records rather than slowing the request that produced them,
# and the dropped count is reported rather than hidden.
# TELEMETRY_QUEUE_SIZE=2000
# TELEMETRY_BATCH_SIZE=100
# TELEMETRY_FLUSH_INTERVAL_SECONDS=1.0
# TELEMETRY_SHUTDOWN_TIMEOUT_SECONDS=5.0

# Off by default, and think before turning it on: it allows instrumented
# stages to store raw question and answer text on their spans. Left off,
# telemetry keeps only counts, scores, durations and model names.
#
# What it widens, specifically: span metadata is written to rag_spans, read
# back by the admin monitoring API, and rendered in the trace explorer. With
# capture on, anything a user typed is visible to any admin and lives until
# the retention window below removes it. The key-based sanitiser strips
# credentials, not content - it cannot tell that a question contains
# something personal.
# TELEMETRY_CAPTURE_TEXT=false

# How long trace and span rows are kept. Enforced by the retention sweep in
# backend/services/telemetry_retention.py: once at startup, then every
# interval. Deleting a trace deletes its spans with it, and spans whose
# trace never arrived are swept by age.
#
# Retention runs whether or not TELEMETRY_ENABLED is set, so turning capture
# off still lets what was already captured age out.
# TELEMETRY_RETENTION_DAYS=30
# TELEMETRY_RETENTION_INTERVAL_HOURS=24

# Stamped onto every trace, so a regression can be attributed to a release
# and one environment's traffic can be told from another's.
# APP_ENV=development
# APP_VERSION=2.0.0

# --- Optional: alerts ------------------------------------------------------

# The evaluator runs on a timer inside the API process, reads the same
# metrics the dashboard shows, and logs whatever starts firing. Off means
# nothing is evaluated and /api/monitoring/alerts reports "not running" -
# which is deliberately not the same as "nothing is wrong".
# ALERTS_ENABLED=true

# Thresholds. Every one of these defaults is wrong for somebody, which is
# why none of them is a constant in the rules.
#
# An alert clears at 80% of its firing threshold, so a metric hovering on
# the line cannot flap.
# ALERT_ERROR_RATE=0.10
# ALERT_P95_MS=15000
# ALERT_COST_PER_HOUR_USD=1.0
# ALERT_DROPPED_RECORDS=0
# ALERT_BM25_EMPTY_RATE=0.5

# Rate rules stay quiet below this many requests in the window. One
# request failing out of one is a 100% error rate, and paging someone for
# it teaches them to ignore the next one.
# ALERT_MIN_REQUESTS=20

# How often to evaluate, and how much history each pass looks at.
# ALERT_INTERVAL_SECONDS=300
# ALERT_WINDOW_MINUTES=15

# Where to POST newly firing alerts, as JSON. Logging happens either way.
# Only what *started* firing is sent - re-sending everything currently
# wrong on every tick is how an alerting system gets muted.
# ALERT_WEBHOOK_URL=

# --- Optional: tests -------------------------------------------------------

# Set to 1 to run integration tests against real Pinecone/Gemini. They skip
# themselves otherwise.
# RUN_REAL_RAG_TESTS=1
