# ---------------------------------------------------------------------------
# Backend environment configuration
#
# Copy this file to .env in this same directory, then fill in your credentials:
#
#   Copy-Item .env.example .env
#
# .env is gitignored - never commit real keys.
# Every variable below is read in rag/src/rag_application/config/settings.py.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------

# Pinecone API key.
PINECONE_API_KEY=

# Pinecone index to create or reuse. It is created automatically on first run
# with cosine similarity on AWS us-east-1, sized to the embedding model.
PINECONE_INDEX_NAME=

# Google Gemini API key.
GEMINI_API_KEY=

# --- Optional: storage -----------------------------------------------------

# Holds bm25_corpus.json and uploads/. Relative paths resolve against the
# working directory, so run the API and scripts from backend/.
# STORAGE_PATH=storage

# --- Optional: chunking ----------------------------------------------------

# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# --- Optional: embedding ---------------------------------------------------

# Changing the model changes the vector dimension. An existing Pinecone index
# built at another dimension will reject upserts, so switch models and index
# names together.
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_BATCH_SIZE=32

# --- Optional: retrieval ---------------------------------------------------

# These populate RetrievalConfig, but note what the live query path actually
# uses today: top_k comes from the request body, and candidate_k defaults to 30
# in HistoryAwareRAGService.answer_with_sources. CANDIDATE_K applies only to
# DenseRetriever calls that pass no explicit top_k.
# CANDIDATE_K=20
# DENSE_TOP_K=20
# RERANKING_K=8
# FINAL_CONTEXT_K=5
# SIMILARITY_THRESHOLD=0.7

# --- Optional: generation --------------------------------------------------

# GENERATION_MODEL_NAME=gemini-3.1-flash-lite

# --- Optional: tests -------------------------------------------------------

# Set to 1 to run integration tests against real Pinecone/Gemini. They skip
# themselves otherwise.
# RUN_REAL_RAG_TESTS=1
