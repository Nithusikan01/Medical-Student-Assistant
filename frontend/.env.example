# ---------------------------------------------------------------------------
# Frontend environment configuration
#
# Copy this file to .env in this same directory to override the defaults:
#
#   Copy-Item .env.example .env
#
# Only VITE_-prefixed variables are exposed to Vite. .env is gitignored.
# ---------------------------------------------------------------------------

# Backend the dev server proxies /api and /health to.
# VITE_BACKEND_URL=http://127.0.0.1:8000
